#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>

#include "zmk-helpers/helper.h"                     // ZMK_HOLD_TAP etc.
#include "zmk-helpers/key-labels/lily58.h"          // LT0-LT5, LM*, LB*, LF*, LH*, LEC/REC ...

// Left-hand keys (incl. the inner "encoder" key).
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5  LM0 LM1 LM2 LM3 LM4 LM5  LB0 LB1 LB2 LB3 LB4 LB5  LF0 LF1 LF2 LF3 LF4 LF5  LEC
// Right-hand keys (incl. the inner "encoder" key).
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5  RM0 RM1 RM2 RM3 RM4 RM5  RB0 RB1 RB2 RB3 RB4 RB5  RF0 RF1 RF2 RF3 RF4 RF5  REC
// Thumb keys.
#define THUMBS LH0 LH1 LH2 LH3  RH0 RH1 RH2 RH3

#define BASE  0
#define RAISE 1
#define LOWER 2

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

// ---------------------------------------------------------------------------------------------------------------------
// |    =     |    1     |    2     |    3     |    4     |    5     |             |   6   |    7    |    8    |    9    |    0     |   `   |
// |   TAB    |    Q     |    W     |    E     |    R     |    T     |             |   Y   |    U    |    I    |    O    |    P     |   -   |
// |   CAPS   | CTRL/A   |  ALT/S   | SHIFT/D  |  GUI/F   |    G     |             |   H   |  GUI/J  | SHIFT/K |  ALT/L  | CTRL/;   |   '   |
// | SHIFT/BSPC |  Z     |    X     |    C     |    V     |    B     |  [  |  ]    |   N   |    M    |    ,    |    .    |    /     | SHIFT/BSPC |
//                                  |  BSPC    |  LA(A)   |  RAISE   | SPACE | ENTER | LOWER |    \    |  BSPC   |
            bindings = <
&kp EQUAL       &kp N1       &kp N2      &kp N3       &kp N4      &kp N5                              &kp N6     &kp N7      &kp N8         &kp N9      &kp N0           &kp GRAVE
&kp TAB         &kp Q        &kp W       &kp E        &kp R       &kp T                               &kp Y      &kp U       &kp I          &kp O       &kp P            &kp MINUS
&kp CAPS        &hml LCTRL A &hml LALT S &hml LSHFT D &hml LGUI F &kp G                               &kp H      &hmr RGUI J &hmr RSHFT K   &hmr RALT L &hmr RCTRL SEMI  &kp SQT
&mt LSHFT BSPC  &kp Z        &kp X       &kp C        &kp V       &kp B     &kp LBKT     &kp RBKT     &kp N      &kp M       &kp COMMA      &kp DOT     &kp FSLH         &mt RSHFT BSPC
                                         &kp BSPC     &kp LA(A)   &mo RAISE &kp SPACE    &kp RET      &mo LOWER  &kp BSLH    &kp BSPC
            >;
        };

        raise_layer {
            display-name = "Raise";
// ---------------------------------------------------------------------------------------------------------------------
// |   BT1    |   BT2    |   BT3    |   BT4    |   BT5    |  unlock  |             | unlock |        |        |        |        | BTCLR |
// |          |          |          |    UP    |          |          |             |        |        |        |        |        |       |
// |          |          |   LEFT   |   DOWN   |  RIGHT   |          |             |        |  LEFT  |   UP   |  DOWN  | RIGHT  |       |
// |          |          |          |          |          |          |    |SCRL_UP |        |        |        |        |        |       |
//                                  |          |          |          |    |SCRL_DN |        |        |        |
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &studio_unlock                          &studio_unlock &trans   &trans  &trans   &trans    &bt BT_CLR
&trans       &trans       &kp UP       &trans       &trans       &trans                                  &trans         &trans   &trans  &trans   &trans    &trans
&trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans       &trans                                  &trans         &kp LEFT &kp UP  &kp DOWN &kp RIGHT &trans
&trans       &trans       &trans       &trans       &trans       &trans   &trans   &msc SCRL_UP          &trans         &trans   &trans  &trans   &trans    &trans
                                       &trans       &trans       &trans   &trans   &msc SCRL_DOWN        &trans         &trans   &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
// ---------------------------------------------------------------------------------------------------------------------
// |   BT1    |   BT2    |   BT3    |   BT4    |   BT5    |  unlock  |             | unlock |        |        |        |        | BTCLR |
// |          |          |          |    UP    |          |          |             |        |        |        |        |        |       |
// |          |          |   LEFT   |   DOWN   |  RIGHT   |          |             |        |  LEFT  |   UP   |  DOWN  | RIGHT  |       |
// |          |          |          |          |          |          |SCRL_LEFT|   |        |        |        |        |        |       |
//                                  |          |          |          |SCRL_RGHT|   |        |        |        |
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &studio_unlock                       &studio_unlock &trans   &trans  &trans   &trans    &bt BT_CLR
&trans       &trans       &kp UP       &trans       &trans          &trans                               &trans         &trans   &trans  &trans   &trans    &trans
&trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans          &trans                               &trans         &kp LEFT &kp UP  &kp DOWN &kp RIGHT &trans
&trans       &trans       &trans       &trans       &trans          &trans          &msc SCRL_LEFT  &trans  &trans      &trans   &trans  &trans   &trans    &trans
                                       &trans       &trans          &trans          &msc SCRL_RIGHT &trans  &trans      &trans   &trans
            >;
        };
    };
};
